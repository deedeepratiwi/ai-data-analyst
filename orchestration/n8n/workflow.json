{
  "name": "AI CSV Business Insight Generator",
  "nodes": [
    {
      "parameters": {
        "path": "csv-upload",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook - CSV Upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "ai-csv-upload"
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/upload",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "file",
              "value": "={{$binary.data}}"
            }
          ]
        },
        "options": {
          "retry": {
            "maxTries": 3,
            "retryInterval": 2000
          }
        }
      },
      "id": "create-job",
      "name": "Create Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/process/{{$json.job_id}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "options": {
          "retry": {
            "maxTries": 3,
            "retryInterval": 5000
          },
          "timeout": 300000
        }
      },
      "id": "start-processing",
      "name": "Start Processing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "wait-5s",
      "name": "Wait 5s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [850, 300],
      "webhookId": "poll-wait"
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/job/{{$json.job_id}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "check-status",
      "name": "Check Job Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "operation": "equals",
              "value2": "completed"
            }
          ]
        }
      },
      "id": "check-completed",
      "name": "Check if Completed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "operation": "equals",
              "value2": "failed"
            }
          ]
        }
      },
      "id": "check-failed",
      "name": "Check if Failed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1250, 500]
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/report/{{$json.job_id}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "get-report",
      "name": "Get Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1450, 200]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.data_quality_score}}",
              "operation": "largerEqual",
              "value2": 70
            }
          ]
        }
      },
      "id": "quality-branch",
      "name": "Quality Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1650, 200]
    },
    {
      "parameters": {
        "url": "={{$json.callback_url}}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "job_id",
              "value": "={{$json.job_id}}"
            },
            {
              "name": "status",
              "value": "success"
            },
            {
              "name": "report_url",
              "value": "={{$env.API_BASE_URL}}/report/{{$json.job_id}}"
            },
            {
              "name": "data_quality_score",
              "value": "={{$json.data_quality_score}}"
            }
          ]
        },
        "options": {}
      },
      "id": "success-notification",
      "name": "Success Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1850, 100]
    },
    {
      "parameters": {
        "url": "={{$json.callback_url}}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "job_id",
              "value": "={{$json.job_id}}"
            },
            {
              "name": "status",
              "value": "success_with_warnings"
            },
            {
              "name": "report_url",
              "value": "={{$env.API_BASE_URL}}/report/{{$json.job_id}}"
            },
            {
              "name": "data_quality_score",
              "value": "={{$json.data_quality_score}}"
            },
            {
              "name": "warning",
              "value": "Data quality below threshold. Review carefully."
            }
          ]
        },
        "options": {}
      },
      "id": "warning-notification",
      "name": "Warning Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1850, 300]
    },
    {
      "parameters": {
        "url": "={{$json.callback_url}}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "job_id",
              "value": "={{$json.job_id}}"
            },
            {
              "name": "status",
              "value": "failed"
            },
            {
              "name": "error",
              "value": "={{$json.error_message}}"
            }
          ]
        },
        "options": {}
      },
      "id": "failure-notification",
      "name": "Failure Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1450, 500]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}"
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2050, 200]
    },
    {
      "parameters": {
        "jsCode": "// Loop back to status check if still processing\nconst status = $input.item.json.status;\nconst iteration = $input.item.json.iteration || 0;\nconst maxIterations = 120; // 10 minutes with 5s delays\n\nif (status === 'processing' && iteration < maxIterations) {\n  return {\n    json: {\n      ...$input.item.json,\n      iteration: iteration + 1,\n      continue_polling: true\n    }\n  };\n} else if (iteration >= maxIterations) {\n  return {\n    json: {\n      ...$input.item.json,\n      status: 'timeout',\n      error_message: 'Job processing timeout after 10 minutes'\n    }\n  };\n} else {\n  return {\n    json: {\n      ...$input.item.json,\n      continue_polling: false\n    }\n  };\n}"
      },
      "id": "poll-controller",
      "name": "Poll Controller",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [1050, 450]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.continue_polling}}",
              "value2": true
            }
          ]
        }
      },
      "id": "should-continue-polling",
      "name": "Continue Polling?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 600]
    }
  ],
